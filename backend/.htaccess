<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^(\.git|vendor|storage/logs|database|bootstrap/cache|app|config|routes|tests) - [F,L,NC]

    # Don't rewrite if request is already in public/
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # If the requested file or directory exists inside public/, serve it
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Rewrite all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# Security: Block sensitive files from direct web download
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|phpunit\.xml)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes
